# Copy this file to .env.local and fill in your values.
# .env.local is gitignored.

# --- Supabase (required) ---
# Project Settings > API in the Supabase dashboard
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — DO NOT EXPOSE TO CLIENT.
# Only used by drizzle-kit and supabase CLI for migrations / RLS tests.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (Project Settings > Database > Connection string > URI)
# Used by drizzle-kit and supabase CLI.
DATABASE_URL=

# --- Google OAuth (required for Google Sign-In) ---
# Google Cloud Console > APIs & Services > Credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
